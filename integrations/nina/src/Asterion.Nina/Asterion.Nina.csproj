<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <!-- builds on Linux and macOS too: only running the plugin needs Windows -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>Asterion.Nina</AssemblyName>
    <RootNamespace>Asterion.Nina</RootNamespace>
    <AssemblyTitle>Asterion Solver</AssemblyTitle>
    <Description>A very fast, modern plate solver. It can generally solve any image within milliseconds even in blind mode.</Description>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <!-- N.I.N.A. provides its assemblies at runtime: they aren't copied -->
    <PackageReference Include="NINA.Plugin" Version="$(NinaVersion)" ExcludeAssets="runtime" PrivateAssets="all" />
    <ProjectReference Include="..\Asterion.Nina.Core\Asterion.Nina.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Asterion.Nina.Tests" />
    <!-- the other metadata of the plugin are in AssemblyInfo.cs -->
    <AssemblyMetadata Include="MinimumApplicationVersion" Value="$(NinaMinimumVersion)" />
  </ItemGroup>
  <!--
    The files of the plugin, without the assemblies which N.I.N.A. provides, in
    bin/<configuration>/plugin. With -p:AsterionLibrary=<the directory of the Windows native library of
    Asterion, libasterion.dll>, it also has the library, the license of Asterion and the notices of what
    the library includes, and is zipped as the plugin to publish.
  -->
  <PropertyGroup>
    <PluginDirectory>$(MSBuildProjectDirectory)/bin/$(Configuration)/plugin/</PluginDirectory>
    <PluginZip>$(MSBuildProjectDirectory)/bin/$(Configuration)/asterion-nina-$(Version).zip</PluginZip>
    <RepositoryDirectory>$(MSBuildProjectDirectory)/../../../../</RepositoryDirectory>
  </PropertyGroup>
  <Target Name="CollectPlugin" AfterTargets="Build">
    <ItemGroup>
      <PluginFile Include="$(OutDir)Asterion.Nina.dll;$(OutDir)Asterion.Nina.pdb;$(OutDir)Asterion.Nina.Core.dll;$(OutDir)Asterion.Nina.Core.pdb" />
      <!-- the library, and the libraries of the JDK which native-image may write next to it -->
      <PluginFile Include="$(AsterionLibrary)/*.dll;$(RepositoryDirectory)LICENSE.txt" Condition="'$(AsterionLibrary)' != ''" />
      <ThirdPartyFile Include="$(RepositoryDirectory)third-party/*.md" Condition="'$(AsterionLibrary)' != ''" />
    </ItemGroup>
    <Error Condition="'$(AsterionLibrary)' != '' And !Exists('$(AsterionLibrary)/libasterion.dll')"
           Text="There is no libasterion.dll in $(AsterionLibrary)" />
    <RemoveDir Directories="$(PluginDirectory)" />
    <Copy SourceFiles="@(PluginFile)" DestinationFolder="$(PluginDirectory)" />
    <Copy SourceFiles="@(ThirdPartyFile)" DestinationFolder="$(PluginDirectory)third-party" />
    <ZipDirectory Condition="'$(AsterionLibrary)' != ''" SourceDirectory="$(PluginDirectory)" DestinationFile="$(PluginZip)" Overwrite="true" />
    <Message Importance="high" Condition="'$(AsterionLibrary)' != ''" Text="Asterion.Nina -> $(PluginZip)" />
  </Target>
</Project>
